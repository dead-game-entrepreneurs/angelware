#!/bin/sh
# Run storage integration tests against a disposable, unpublished database.
set -eu
cd "$(dirname "$0")/.."
pg_name="angelware-storage-test-$$"
trap 'docker rm -f "$pg_name" >/dev/null 2>&1 || true' EXIT HUP INT TERM
docker run --rm -d --name "$pg_name" -e POSTGRES_PASSWORD=angelware-test postgres:18 >/dev/null
attempt=0
until docker exec "$pg_name" pg_isready -U postgres >/dev/null 2>&1; do
 attempt=$((attempt+1))
 if [ "$attempt" -ge 40 ]; then echo 'Test database did not become ready' >&2; exit 1; fi
 sleep 1
done
docker run --rm -i -u "$(id -u):$(id -g)" --network "container:$pg_name" \
 -v "$PWD":/src -w /src -v angelware-gocache:/cache \
 -e GOCACHE=/cache/build -e GOMODCACHE=/cache/mod -e GOFLAGS=-buildvcs=false \
 -e ANGELWARE_TEST_DATABASE_URL=postgres://postgres:angelware-test@127.0.0.1/postgres?sslmode=disable \
 golang:1.27.4-alpine go test -count=1 ./internal/storage
